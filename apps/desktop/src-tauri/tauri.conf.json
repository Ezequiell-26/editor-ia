{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Olyvia",
  "version": "0.1.0",
  "identifier": "com.editoria.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Olyvia",
        "width": 900,
        "height": 580,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": false,
        "fullscreen": false,
        "maximized": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#05070f",
        "additionalBrowserArgs": "--in-process-gpu",
        "maximizable": false
      },
      {
        "label": "splash",
        "title": "Olyvia",
        "url": "splash.html",
        "width": 1040,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#05070f",
        "additionalBrowserArgs": "--in-process-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' asset: http://asset.localhost ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../extensions/editor-ia-downloader": "extension/editor-ia-downloader",
      "resources/ffmpeg/*": "ffmpeg/",
      "resources/ffmpeg-dll/avcodec-63.dll": "avcodec-63.dll",
      "resources/ffmpeg-dll/avdevice-63.dll": "avdevice-63.dll",
      "resources/ffmpeg-dll/avfilter-12.dll": "avfilter-12.dll",
      "resources/ffmpeg-dll/avformat-63.dll": "avformat-63.dll",
      "resources/ffmpeg-dll/avutil-61.dll": "avutil-61.dll",
      "resources/ffmpeg-dll/swscale-10.dll": "swscale-10.dll",
      "resources/ffmpeg-dll/swresample-7.dll": "swresample-7.dll",
      "resources/ffmpeg-dll/LICENSE.txt": "FFMPEG-LICENSE.txt",
      "resources/tools/*": "tools/",
      "resources/onnxruntime/onnxruntime.dll": "onnxruntime.dll",
      "resources/piper": "piper",
      "resources/watermark.png": "watermark.png",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Spanish"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp"
      },
      "certificateThumbprint": "58204858E163CE7DA173DB8AB09CD9B8359C3954",
      "digestAlgorithm": "sha256",
      "tsp": false
    }
  }
}
