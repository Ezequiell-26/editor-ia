//! Seguimiento de objeto genérico por template matching (NCC).
//!
//! Equivalente legal e independiente del object tracking de AlaukCut
//! (`rastreamento.js`): no usa modelos propietarios ni detección por
//! clases — el usuario siembra un rectángulo (típicamente el bbox de una
//! máscara dibujada) y el tracker lo sigue cuadro a cuadro con
//! correlación cruzada normalizada sobre una versión reducida del frame.
//!
//! Los frames se extraen con FFmpeg a rawvideo rgb24 escalado a un lado
//! máximo de `MAX_DIM` px y se consumen en streaming (nunca se acumulan en
//! memoria). La salida usa la misma forma que `FaceSample`, así el frontend
//! puede reutilizar `applyFaceBlurOverlay` para blur/máscara que sigue al
//! objeto.

use std::io::Read;
use std::path::PathBuf;
use std::process::{Command, Stdio};

use serde::{Deserialize, Serialize};
use tauri::{AppHandle, State};

use crate::commands::system::resolve_tools;
use crate::commands::shorts::validate_face_range;
use crate::media::resolve_inside_root;
use crate::projects::service::{ProjectError, ProjectErrorCode};
use crate::state::AppState;

const SAMPLE_FPS: u32 = 6;
const MAX_DIM: u32 = 256;
const MIN_DIM: u32 = 32;
/// Límite de ventana analizada: el tracking es por clip, no por película.
const MAX_TRACK_SECONDS: f64 = 180.0;
/// Pasada de búsqueda en píxeles (paso 3 reduce ~9× el coste de NCC).
const SEARCH_STEP: i32 = 3;
/// NCC mínimo para considerar que el objeto sigue visible.
const MIN_CONFIDENCE: f64 = 0.45;

#[derive(Debug, Clone, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct ObjectTrackRect {
    /// Esquina superior izquierda, normalizada 0..1 del frame fuente.
    pub x: f64,
    pub y: f64,
    pub w: f64,
    pub h: f64,
}

#[derive(Debug, Clone, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct ObjectTrackRequest {
    pub path: String,
    pub rect: ObjectTrackRect,
    pub start_seconds: f64,
    pub end_seconds: f64,
}

#[derive(Debug, Clone, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct ObjectTrackSample {
    pub time: f64,
    pub center_x: f64,
    pub center_y: f64,
    /// Lado mayor del patch como fracción del lado mayor del frame.
    pub size: f64,
    /// 0..1 — NCC del mejor candidato; valores bajos marcan oclusión.
    pub confidence: f64,
    /// Rotación estimada del patch en grados (0 = sin rotar).
    pub rotation_deg: f64,
}

#[derive(Debug, Clone, Serialize)]
#[serde(rename_all = "camelCase")]
pub struct ObjectTrackResult {
    pub samples: Vec<ObjectTrackSample>,
    /// Frames muestreados en total.
    pub frames: u32,
    /// Muestras con confianza aceptable.
    pub confident: u32,
    pub duration_seconds: f64,
    pub scaled_width: u32,
    pub scaled_height: u32,
}

#[tauri::command]
pub async fn track_object(
    app: AppHandle,
    state: State<'_, AppState>,
    request: ObjectTrackRequest,
) -> Result<ObjectTrackResult, ProjectError> {
    let session = state.require_session()?;
    let input = resolve_inside_root(&session.root, &request.path)?;
    if !input.is_file() {
        return Err(ProjectError::message(
            ProjectErrorCode::NotFound,
            "el video para seguir ya no está en el proyecto",
        ));
    }
    let duration = validate_object_range(request.start_seconds, request.end_seconds)?;
    let rect = validate_rect(&request.rect)?;
    let settings = state.settings_snapshot()?;
    let (ffmpeg, ffprobe, _) = resolve_tools(&settings);
    let (Some(ffmpeg), Some(ffprobe)) = (ffmpeg, ffprobe) else {
        return Err(ProjectError::message(
            ProjectErrorCode::Io,
            "FFmpeg/FFprobe no están disponibles para el seguimiento",
        ));
    };
    let (src_w, src_h) = probe_dimensions(&ffprobe, &input)?;
    let (w, h) = scaled_dims(src_w, src_h);
    let samples = track_stream(
        Some(&app),
        &ffmpeg,
        &input,
        request.start_seconds,
        duration,
        rect,
        w,
        h,
    )?;
    let confident = samples.iter().filter(|s| s.confidence >= MIN_CONFIDENCE).count() as u32;
    Ok(ObjectTrackResult {
        frames: samples.len() as u32,
        confident,
        samples,
        duration_seconds: duration,
        scaled_width: w,
        scaled_height: h,
    })
}

fn validate_object_range(start: f64, end: f64) -> Result<f64, ProjectError> {
    let duration = validate_face_range(start, end)?;
    if duration > MAX_TRACK_SECONDS {
        return Err(ProjectError::message(
            ProjectErrorCode::InvalidProject,
            &format!(
                "el seguimiento de objeto admite hasta {MAX_TRACK_SECONDS:.0} segundos por análisis"
            ),
        ));
    }
    Ok(duration)
}

fn validate_rect(rect: &ObjectTrackRect) -> Result<ObjectTrackRect, ProjectError> {
    let finite = |v: f64| v.is_finite();
    if !(finite(rect.x)
        && finite(rect.y)
        && finite(rect.w)
        && finite(rect.h)
        && rect.x >= 0.0
        && rect.y >= 0.0
        && rect.x <= 1.0
        && rect.y <= 1.0
        && rect.w >= 0.005
        && rect.h >= 0.005
        && rect.x + rect.w <= 1.0001
        && rect.y + rect.h <= 1.0001)
    {
        return Err(ProjectError::message(
            ProjectErrorCode::InvalidProject,
            "la región a seguir debe ser un rectángulo válido dentro del frame",
        ));
    }
    Ok(ObjectTrackRect {
        x: rect.x,
        y: rect.y,
        w: rect.w.min(1.0 - rect.x),
        h: rect.h.min(1.0 - rect.y),
    })
}

fn scaled_dims(src_w: u32, src_h: u32) -> (u32, u32) {
    if src_w == 0 || src_h == 0 {
        return (MAX_DIM, MAX_DIM);
    }
    let (mut w, mut h) = if src_w >= src_h {
        (MAX_DIM, (MAX_DIM * src_h / src_w).max(2))
    } else {
        ((MAX_DIM * src_w / src_h).max(2), MAX_DIM)
    };
    w = w.clamp(MIN_DIM, MAX_DIM * 2);
    h = h.clamp(MIN_DIM, MAX_DIM * 2);
    (w, h)
}

fn probe_dimensions(ffprobe: &PathBuf, input: &std::path::Path) -> Result<(u32, u32), ProjectError> {
    let output = Command::new(ffprobe)
        .args([
            "-v",
            "error",
            "-select_streams",
            "v:0",
            "-show_entries",
            "stream=width,height",
            "-of",
            "csv=p=0",
            &input.to_string_lossy(),
        ])
        .output()
        .map_err(|error| {
            ProjectError::message(
                ProjectErrorCode::Io,
                format!("no se pudo consultar el video: {error}").as_str(),
            )
        })?;
    if !output.status.success() {
        return Err(ProjectError::message(
            ProjectErrorCode::Io,
            "FFprobe no pudo leer las dimensiones del video",
        ));
    }
    let text = String::from_utf8_lossy(&output.stdout);
    let mut parts = text.trim().split(',');
    let w = parts.next().and_then(|v| v.parse::<u32>().ok()).unwrap_or(0);
    let h = parts.next().and_then(|v| v.parse::<u32>().ok()).unwrap_or(0);
    if w == 0 || h == 0 {
        return Err(ProjectError::message(
            ProjectErrorCode::InvalidProject,
            "el video no declara dimensiones válidas",
        ));
    }
    Ok((w, h))
}

// ---------------------------------------------------------------------------
// Núcleo del tracker (puro, testeable sin FFmpeg)
// ---------------------------------------------------------------------------

#[derive(Debug, Clone, Copy)]
struct Patch {
    x: i32,
    y: i32,
    w: i32,
    h: i32,
}

fn to_gray(frame: &[u8]) -> Vec<f32> {
    frame
        .chunks_exact(3)
        .map(|px| 0.299 * px[0] as f32 + 0.587 * px[1] as f32 + 0.114 * px[2] as f32)
        .collect()
}

fn patch_values(gray: &[f32], width: i32, patch: Patch) -> Vec<f32> {
    let mut out = Vec::with_capacity((patch.w * patch.h) as usize);
    for row in 0..patch.h {
        let base = ((patch.y + row) * width + patch.x) as usize;
        for col in 0..patch.w {
            out.push(gray[base + col as usize]);
        }
    }
    out
}

/// NCC entre el template (ya centrado y normalizado) y una ventana.
fn ncc_centered(template: &[f32], template_norm: f64, window: &[f32]) -> f64 {
    let n = window.len() as f64;
    if n == 0.0 || template_norm <= 0.0 {
        return 0.0;
    }
    let mean = window.iter().sum::<f32>() as f64 / n;
    let mut dot = 0.0f64;
    let mut norm = 0.0f64;
    for (t, w) in template.iter().zip(window.iter()) {
        let d = (*w as f64) - mean;
        dot += (*t as f64) * d;
        norm += d * d;
    }
    if norm <= 0.0 {
        return 0.0;
    }
    dot / (template_norm * norm.sqrt())
}

fn centered_template(patch: &[f32]) -> (Vec<f32>, f64) {
    let n = patch.len() as f64;
    let mean = patch.iter().sum::<f32>() as f64 / n.max(1.0);
    let centered: Vec<f32> = patch.iter().map(|v| *v - mean as f32).collect();
    let norm = centered.iter().map(|v| (*v as f64) * (*v as f64)).sum::<f64>().sqrt();
    (centered, norm)
}

/// Escalas candidatas por frame alrededor del tamaño actual del patch.
/// La ventana se re-muestrea al tamaño del template antes del NCC, así la
/// comparación sigue siendo válida aunque el objeto cambie de tamaño.
const SCALE_CANDIDATES: [f64; 3] = [0.8, 1.0, 1.25];
/// Rango total de escala respecto al rectángulo semilla.
const MIN_SCALE: f64 = 0.6;
const MAX_SCALE: f64 = 1.8;

/// Re-muestreo bilineal de una ventana rectangular del frame gris a
/// `out_w × out_h` (típicamente el tamaño del template).
fn resized_window(
    gray: &[f32],
    width: i32,
    height: i32,
    patch: Patch,
    out_w: usize,
    out_h: usize,
) -> Vec<f32> {
    let mut out = Vec::with_capacity(out_w * out_h);
    for row in 0..out_h {
        let fy = patch.y as f64 + (row as f64 + 0.5) * patch.h as f64 / out_h as f64 - 0.5;
        let y0 = fy.floor() as i32;
        let y1 = (y0 + 1).min(height - 1).max(0);
        let wy = (fy - y0 as f64).clamp(0.0, 1.0);
        for col in 0..out_w {
            let fx = patch.x as f64 + (col as f64 + 0.5) * patch.w as f64 / out_w as f64 - 0.5;
            let x0 = fx.floor() as i32;
            let x1 = (x0 + 1).min(width - 1).max(0);
            let wx = (fx - x0 as f64).clamp(0.0, 1.0);
            let y0c = y0.clamp(0, height - 1);
            let y1c = y1.clamp(0, height - 1);
            let x0c = x0.clamp(0, width - 1);
            let base0 = (y0c * width + x0c) as usize;
            let base1 = (y1c * width + x0c) as usize;
            let base2 = (y0c * width + x1) as usize;
            let base3 = (y1c * width + x1) as usize;
            let top = gray[base0] as f64 * (1.0 - wx) + gray[base2] as f64 * wx;
            let bottom = gray[base1] as f64 * (1.0 - wx) + gray[base3] as f64 * wx;
            out.push((top * (1.0 - wy) + bottom * wy) as f32);
        }
    }
    out
}

/// Ángulos candidatos por frame (grados) alrededor de la rotación actual.
const ROTATION_STEP_DEG: f64 = 7.5;
const ROTATION_CANDIDATES: usize = 2; // -2..=+2 pasos
/// Rotación máxima acumulada respecto a la semilla.
const MAX_ROTATION_DEG: f64 = 60.0;

/// Muestrea una ventana centrada en (cx, cy) de `patch_w × patch_h` rotada
/// `angle_deg` grados (horario positivo, coordenadas de imagen) y la
/// re-muestrea bilineal a `out_w × out_h` para comparar con el template.
#[allow(clippy::too_many_arguments)]
fn rotated_window(
    gray: &[f32],
    width: i32,
    height: i32,
    cx: f64,
    cy: f64,
    patch_w: i32,
    patch_h: i32,
    angle_deg: f64,
    out_w: usize,
    out_h: usize,
) -> Vec<f32> {
    let rad = angle_deg.to_radians();
    let (sin, cos) = rad.sin_cos();
    // Coordenadas de la ventana sin rotar, centradas en el patch.
    let hx = patch_w as f64 / 2.0;
    let hy = patch_h as f64 / 2.0;
    let mut out = Vec::with_capacity(out_w * out_h);
    for row in 0..out_h {
        // Posición en la ventana rotada → coordenada fuente (rotación
        // inversa alrededor del centro del patch).
        let vy = (row as f64 + 0.5) / out_h as f64 * patch_h as f64 - hy;
        for col in 0..out_w {
            let vx = (col as f64 + 0.5) / out_w as f64 * patch_w as f64 - hx;
            let sx = cx + vx * cos + vy * sin;
            let sy = cy - vx * sin + vy * cos;
            // Bilineal sobre el frame.
            let x0 = sx.floor() as i32;
            let y0 = sy.floor() as i32;
            let fx = (sx - x0 as f64).clamp(0.0, 1.0);
            let fy = (sy - y0 as f64).clamp(0.0, 1.0);
            let x0c = x0.clamp(0, width - 1);
            let x1c = (x0 + 1).clamp(0, width - 1);
            let y0c = y0.clamp(0, height - 1);
            let y1c = (y0 + 1).clamp(0, height - 1);
            let i00 = (y0c * width + x0c) as usize;
            let i01 = (y0c * width + x1c) as usize;
            let i10 = (y1c * width + x0c) as usize;
            let i11 = (y1c * width + x1c) as usize;
            let top = gray[i00] as f64 * (1.0 - fx) + gray[i01] as f64 * fx;
            let bottom = gray[i10] as f64 * (1.0 - fx) + gray[i11] as f64 * fx;
            out.push((top * (1.0 - fy) + bottom * fy) as f32);
        }
    }
    out
}

/// Mejor (score, ángulo) probando la rotación actual ± pasos.
#[allow(clippy::too_many_arguments)]
fn best_rotation_at(
    gray: &[f32],
    width: i32,
    height: i32,
    cx: f64,
    cy: f64,
    patch_w: i32,
    patch_h: i32,
    current_deg: f64,
    template: &[f32],
    template_norm: f64,
    out_w: usize,
    out_h: usize,
) -> (f64, f64) {
    let mut best = (f64::NEG_INFINITY, current_deg);
    for step in -(ROTATION_CANDIDATES as i32)..=(ROTATION_CANDIDATES as i32) {
        let angle = (current_deg + step as f64 * ROTATION_STEP_DEG)
            .clamp(-MAX_ROTATION_DEG, MAX_ROTATION_DEG);
        let window = rotated_window(
            gray, width, height, cx, cy, patch_w, patch_h, angle, out_w, out_h,
        );
        let score = ncc_centered(template, template_norm, &window);
        if score > best.0 {
            best = (score, angle);
        }
    }
    best
}

/// Mejor escala en el centro dado: compara el NCC de la ventana re-muestreada
/// a tamaño de template para cada candidata y devuelve (score, patch w, h).
/// `patch_w`/`patch_h` son el tamaño actual; las candidatas lo escalan por
/// `SCALE_CANDIDATES` y quedan acotadas a `seed_w/h × MIN/MAX_SCALE`.
#[allow(clippy::too_many_arguments)]
fn best_scale_at(
    gray: &[f32],
    width: i32,
    height: i32,
    center_x: f64,
    center_y: f64,
    patch_w: i32,
    patch_h: i32,
    seed_w: i32,
    seed_h: i32,
    template: &[f32],
    template_norm: f64,
    out_w: usize,
    out_h: usize,
) -> (f64, i32, i32) {
    let min_w = ((seed_w as f64 * MIN_SCALE).round() as i32).max(6);
    let min_h = ((seed_h as f64 * MIN_SCALE).round() as i32).max(6);
    let max_w = ((seed_w as f64 * MAX_SCALE).round() as i32)
        .min(width.saturating_sub(2))
        .max(6);
    let max_h = ((seed_h as f64 * MAX_SCALE).round() as i32)
        .min(height.saturating_sub(2))
        .max(6);
    let mut best = (f64::NEG_INFINITY, patch_w, patch_h);
    for factor in SCALE_CANDIDATES {
        let w = ((patch_w as f64 * factor).round() as i32).clamp(min_w, max_w);
        let h = ((patch_h as f64 * factor).round() as i32).clamp(min_h, max_h);
        let px = (center_x - w as f64 / 2.0).round().clamp(0.0, (width - w) as f64) as i32;
        let py = (center_y - h as f64 / 2.0).round().clamp(0.0, (height - h) as f64) as i32;
        let window = resized_window(
            gray,
            width,
            height,
            Patch { x: px, y: py, w, h },
            out_w,
            out_h,
        );
        let score = ncc_centered(template, template_norm, &window);
        if score > best.0 {
            best = (score, w, h);
        }
    }
    best
}

fn track_frames(
    frames: &[Vec<u8>],
    width: u32,
    height: u32,
    rect: &ObjectTrackRect,
) -> Vec<ObjectTrackSample> {
    if frames.is_empty() {
        return Vec::new();
    }
    let (w_i, h_i) = (width as i32, height as i32);
    let mut seed = Patch {
        x: (rect.x * width as f64) as i32,
        y: (rect.y * height as f64) as i32,
        w: ((rect.w * width as f64).round() as i32).max(8),
        h: ((rect.h * height as f64).round() as i32).max(8),
    };
    seed.x = seed.x.clamp(0, (w_i - seed.w).max(0));
    seed.y = seed.y.clamp(0, (h_i - seed.h).max(0));
    seed.w = seed.w.min(w_i);
    seed.h = seed.h.min(h_i);
    if seed.w < 4 || seed.h < 4 {
        return Vec::new();
    }

    let mut out = Vec::with_capacity(frames.len());
    let gray0 = to_gray(&frames[0]);
    let template_patch = patch_values(&gray0, w_i, seed);
    let (template, template_norm) = centered_template(&template_patch);
    let seed_w = seed.w;
    let seed_h = seed.h;
    let mut patch_w = seed.w;
    let mut patch_h = seed.h;
    // La búsqueda de posición siempre usa la ventana del tamaño semilla:
    // el NCC exige template y ventana del mismo largo. La escala se
    // re-evalúa aparte re-muestreando al tamaño del template.
    let search_w = seed.w;
    let search_h = seed.h;
    let radius = (search_w.max(search_h) / 2).clamp(12, 72);

    let mut center_x = seed.x as f64 + patch_w as f64 / 2.0;
    let mut center_y = seed.y as f64 + patch_h as f64 / 2.0;
    let mut rotation_deg = 0.0f64;

    for (index, frame) in frames.iter().enumerate() {
        let gray = to_gray(frame);
        if index > 0 {
            let mut best = (f64::NEG_INFINITY, center_x, center_y);
            let min_cx = (center_x - radius as f64).max(search_w as f64 / 2.0);
            let max_cx = (center_x + radius as f64).min(w_i as f64 - search_w as f64 / 2.0);
            let min_cy = (center_y - radius as f64).max(search_h as f64 / 2.0);
            let max_cy = (center_y + radius as f64).min(h_i as f64 - search_h as f64 / 2.0);
            let mut cy = min_cy;
            while cy <= max_cy {
                let mut cx = min_cx;
                while cx <= max_cx {
                    let px = (cx - search_w as f64 / 2.0).round() as i32;
                    let py = (cy - search_h as f64 / 2.0).round() as i32;
                    let candidate = Patch {
                        x: px,
                        y: py,
                        w: search_w,
                        h: search_h,
                    };
                    let window = patch_values(&gray, w_i, candidate);
                    let score = ncc_centered(&template, template_norm, &window);
                    if score > best.0 {
                        best = (score, cx, cy);
                    }
                    cx += SEARCH_STEP as f64;
                }
                cy += SEARCH_STEP as f64;
            }
            if best.0 >= MIN_CONFIDENCE {
                center_x = best.1;
                center_y = best.2;
                // Re-evalúa escala en el mejor centro: la ventana se
                // re-muestrea al tamaño del template para cada candidata.
                let (scale_score, sw, sh) = best_scale_at(
                    &gray,
                    w_i,
                    h_i,
                    center_x,
                    center_y,
                    patch_w,
                    patch_h,
                    seed_w,
                    seed_h,
                    &template,
                    template_norm,
                    seed_w as usize,
                    seed_h as usize,
                );
                if scale_score >= MIN_CONFIDENCE {
                    patch_w = sw;
                    patch_h = sh;
                    center_x = center_x.clamp(
                        patch_w as f64 / 2.0,
                        w_i as f64 - patch_w as f64 / 2.0,
                    );
                    center_y = center_y.clamp(
                        patch_h as f64 / 2.0,
                        h_i as f64 - patch_h as f64 / 2.0,
                    );
                }
                // Re-evalúa rotación en el centro ya ajustado: ventana
                // rotada re-muestreada al tamaño del template.
                let (rot_score, rot) = best_rotation_at(
                    &gray,
                    w_i,
                    h_i,
                    center_x,
                    center_y,
                    patch_w,
                    patch_h,
                    rotation_deg,
                    &template,
                    template_norm,
                    seed_w as usize,
                    seed_h as usize,
                );
                if rot_score >= MIN_CONFIDENCE {
                    rotation_deg = rot;
                }
            }
            // Si la confianza cae por debajo del umbral se conserva la última
            // posición (posible oclusión); el sample lo reporta vía confidence.
            let confidence = best.0.max(0.0);
            out.push(ObjectTrackSample {
                time: index as f64 / SAMPLE_FPS as f64,
                center_x: (center_x / width as f64).clamp(0.0, 1.0),
                center_y: (center_y / height as f64).clamp(0.0, 1.0),
                size: (patch_w.max(patch_h) as f64 / width.max(height) as f64)
                    .clamp(0.01, 1.0),
                confidence,
                rotation_deg,
            });
        } else {
            out.push(ObjectTrackSample {
                time: 0.0,
                center_x: (center_x / width as f64).clamp(0.0, 1.0),
                center_y: (center_y / height as f64).clamp(0.0, 1.0),
                size: (patch_w.max(patch_h) as f64 / width.max(height) as f64)
                    .clamp(0.01, 1.0),
                confidence: 1.0,
                rotation_deg,
            });
        }
    }
    out
}

#[allow(clippy::too_many_arguments)]
fn track_stream(
    app: Option<&AppHandle>,
    ffmpeg: &PathBuf,
    input: &std::path::Path,
    start_seconds: f64,
    duration: f64,
    rect: ObjectTrackRect,
    width: u32,
    height: u32,
) -> Result<Vec<ObjectTrackSample>, ProjectError> {
    let filter = format!("fps={SAMPLE_FPS},scale={width}:{height}");
    let mut command = Command::new(ffmpeg);
    command
        .args(["-hide_banner", "-loglevel", "error", "-nostdin"])
        .arg("-ss")
        .arg(format!("{start_seconds:.3}"))
        .arg("-t")
        .arg(format!("{duration:.3}"))
        .arg("-i")
        .arg(input)
        .args(["-vf", &filter, "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]);
    crate::commands::hide_console(&mut command);
    let mut child = command.stdout(Stdio::piped()).spawn().map_err(|error| {
        ProjectError::message(
            ProjectErrorCode::Io,
            format!("no se pudo lanzar FFmpeg para el seguimiento: {error}").as_str(),
        )
    })?;
    let mut stdout = child.stdout.take().ok_or_else(|| {
        ProjectError::message(ProjectErrorCode::Io, "FFmpeg no devolvió frames")
    })?;
    let frame_bytes = (width * height * 3) as usize;
    let mut frames: Vec<Vec<u8>> = Vec::new();
    let mut buffer = vec![0u8; frame_bytes];
    loop {
        match stdout.read_exact(&mut buffer) {
            Ok(()) => frames.push(buffer.clone()),
            Err(_) => break,
        }
        // Límite de seguridad: 6 fps × 180 s = 1080 frames.
        if frames.len() >= (SAMPLE_FPS as usize * MAX_TRACK_SECONDS as usize) + 8 {
            break;
        }
    }
    let _ = child.wait();
    if frames.is_empty() {
        return Err(ProjectError::message(
            ProjectErrorCode::Io,
            "FFmpeg no produjo frames para el seguimiento",
        ));
    }
    let _ = app;
    Ok(track_frames(&frames, width, height, &rect))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn validate_rect_rejects_invalid_and_clamps() {
        assert!(validate_rect(&ObjectTrackRect { x: 0.5, y: 0.5, w: 0.6, h: 0.4 }).is_err());
        assert!(validate_rect(&ObjectTrackRect { x: -0.2, y: 0.0, w: 0.3, h: 0.3 }).is_err());
        assert!(validate_rect(&ObjectTrackRect { x: 0.8, y: 0.0, w: 0.4, h: 0.3 }).is_err());
        let ok = validate_rect(&ObjectTrackRect { x: 0.8, y: 0.0, w: 0.15, h: 0.3 }).unwrap();
        assert!((ok.w - 0.15).abs() < 1e-9);
    }

    #[test]
    fn ncc_scores_identical_patch_high() {
        let patch: Vec<f32> = (0..64).map(|i| (i % 8) as f32).collect();
        let (template, norm) = centered_template(&patch);
        let score = ncc_centered(&template, norm, &patch);
        assert!(score > 0.99, "score={score}");
        let shifted: Vec<f32> = (0..64).map(|i| ((i + 3) % 8) as f32).collect();
        let score2 = ncc_centered(&template, norm, &shifted);
        assert!(score2 < score);
    }

    /// Genera frames rgb24 sintéticos con un cuadrado blanco que se mueve y
    /// crece sobre fondo negro — ejercicio real de track_frames. El cuadrado
    /// es más chico que la semilla para que el template tenga borde (un patch
    /// uniforme tiene norma ~0 y el NCC no es válido).
    fn synthetic_frames(count: usize, width: u32, height: u32, grow: f64) -> Vec<Vec<u8>> {
        let mut frames = Vec::with_capacity(count);
        for index in 0..count {
            let mut frame = vec![0u8; (width * height * 3) as usize];
            let side = (12.0 * (1.0 + grow * index as f64)) as u32;
            let cx = 36 + index as u32 * 2;
            let cy = 34;
            for row in 0..side {
                for col in 0..side {
                    let x = cx + col;
                    let y = cy + row;
                    if x < width && y < height {
                        let base = ((y * width + x) * 3) as usize;
                        frame[base] = 240;
                        frame[base + 1] = 240;
                        frame[base + 2] = 240;
                    }
                }
            }
            frames.push(frame);
        }
        frames
    }

    #[test]
    fn track_frames_follows_moving_and_growing_object() {
        let (w, h) = (128u32, 96u32);
        let frames = synthetic_frames(6, w, h, 0.2);
        // Semilla 24×24 centrada en el cuadrado inicial (12px) + margen negro.
        let rect = ObjectTrackRect {
            x: 34.0 / w as f64,
            y: 32.0 / h as f64,
            w: 24.0 / w as f64,
            h: 24.0 / h as f64,
        };
        let samples = track_frames(&frames, w, h, &rect);
        assert_eq!(samples.len(), 6);
        // El centro avanza ~3px por frame en el frame escalado.
        let last = samples.last().unwrap();
        assert!(last.center_x > samples[0].center_x, "no siguió el movimiento");
        // La confianza no colapsa en una secuencia sintética limpia.
        assert!(last.confidence > 0.5, "confidence={}", last.confidence);
        // El tamaño reportado crece con el objeto.
        assert!(last.size > samples[0].size, "no detectó el crecimiento");
    }

    #[test]
    fn best_rotation_prefers_zero_on_symmetric_content() {
        // Frame 64×64; el patch 24×24 contiene un triángulo asimétrico
        // (mitad inferior derecha) para que la rotación sea detectable.
        let (w, h) = (64i32, 64i32);
        let mut gray = vec![0.0f32; (w * h) as usize];
        for row in 20..44 {
            for col in 20..44 {
                if col >= row {
                    gray[(row * w + col) as usize] = 200.0;
                }
            }
        }
        // El template es el patch 24×24 en (20,20).
        let patch = Patch { x: 20, y: 20, w: 24, h: 24 };
        let template_patch = patch_values(&gray, w, patch);
        let (template, norm) = centered_template(&template_patch);
        let (score, angle) = best_rotation_at(
            &gray, w, h, 32.0, 32.0, 24, 24, 0.0,
            &template, norm, 24, 24,
        );
        assert!(score > 0.9, "score={score}");
        assert!(angle.abs() < 1e-9, "angle={angle}");
    }

    #[test]
    fn scaled_dims_keeps_aspect_within_bounds() {
        let (w, h) = scaled_dims(1920, 1080);
        assert_eq!(w, MAX_DIM);
        assert!(h < MAX_DIM && h >= MIN_DIM);
        let (w2, h2) = scaled_dims(1080, 1920);
        assert_eq!(h2, MAX_DIM);
        assert!(w2 < MAX_DIM);
    }
}
