/* 4.6 Timeline: grafito, regla fina, playhead blanco. */
:root[data-theme='dark'] .app-shell .timeline-panel,
:root[data-theme='dark'] .app-shell .timeline-surface,
:root[data-theme='dark'] .app-shell .timeline-scroll {
  background: #303030 !important;
  border-color: #3b3b3b !important;
}
:root[data-theme='dark'] .app-shell .timeline-toolbar,
:root[data-theme='dark'] .app-shell .timeline-tabs {
  background: #262626 !important;
  border-bottom: 1px solid #3b3b3b !important;
  height: 36px !important;
  min-height: 36px !important;
}
:root[data-theme='dark'] .app-shell .timeline-tools button,
:root[data-theme='dark'] .app-shell .timeline-toolbar button {
  border-radius: 4px !important;
  color: #bdbdbd !important;
}
:root[data-theme='dark'] .app-shell .timeline-tools button:hover,
:root[data-theme='dark'] .app-shell .timeline-toolbar button:hover {
  background: #3d3d3d !important;
  color: #ffffff !important;
}
:root[data-theme='dark'] .app-shell .ruler-row,
:root[data-theme='dark'] .app-shell .ruler-lane,
:root[data-theme='dark'] .app-shell .ruler-corner,
:root[data-theme='dark'] .app-shell .track-head {
  background: #2b2b2b !important;
  border-color: #3b3b3b !important;
}
:root[data-theme='dark'] .app-shell .track-lane { background: #262626 !important; }
:root[data-theme='dark'] .app-shell .ruler-tick {
  color: #a8a8a8 !important;
  font-size: 10px !important;
  font-variant-numeric: tabular-nums !important;
}
:root[data-theme='dark'] .app-shell .ruler-minor { background: rgba(255,255,255,0.1) !important; }
:root[data-theme='dark'] .app-shell .timeline-clip {
  border: 1px solid rgba(255,255,255,0.14) !important;
  border-radius: 4px !important;
  box-shadow: 0 1px 2px rgba(0,0,0,0.45) !important;
}
:root[data-theme='dark'] .app-shell .timeline-clip.selected,
:root[data-theme='dark'] .app-shell .timeline-clip[aria-selected='true'] {
  outline: 2px solid #00c1cd !important;
  outline-offset: -2px !important;
}
:root[data-theme='dark'] .app-shell .playhead-line { width: 2px !important; background: #ffffff !important; }
:root[data-theme='dark'] .app-shell .playhead-grip {
  background: #ffffff !important;
  border-radius: 1px !important;
  clip-path: polygon(0 0, 100% 0, 100% 58%, 50% 100%, 0 58%) !important;
}
:root[data-theme='dark'] .app-shell .trim-handle { background: #00c1cd !important; width: 3px !important; }
:root[data-theme='dark'] .app-shell .timeline-empty {
  border: 1px dashed #4d4d4d !important;
  border-radius: 6px !important;
  color: #9a9a9a !important;
}

/* 4.7 Transporte */
:root[data-theme='dark'] .app-shell .transport-scrub { height: 3px !important; background: #4a4a4a !important; border-radius: 2px !important; }
:root[data-theme='dark'] .app-shell .transport-scrub-knob { background: #ffffff !important; border-color: #ffffff !important; }
:root[data-theme='dark'] .app-shell .transport-button { color: #d0d0d0 !important; border-radius: 4px !important; }
:root[data-theme='dark'] .app-shell .transport-button:hover { background: #363636 !important; color: #ffffff !important; }
:root[data-theme='dark'] .app-shell .transport-button.primary-transport { color: #4fe3ec !important; }

/* 4.8 Estado vacío del editor: orientación clara y accionable. */
:root[data-theme='dark'] .app-shell .editor-empty-card {
  background: #262626 !important;
  border: 1px solid #3d3d3d !important;
  border-radius: 12px !important;
  box-shadow: 0 16px 48px rgba(0,0,0,0.4) !important;
}
:root[data-theme='dark'] .app-shell .editor-empty-eyebrow {
  color: #4fe3ec !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  letter-spacing: 0.12em !important;
  text-transform: uppercase !important;
}
:root[data-theme='dark'] .app-shell .editor-empty-title { color: #ffffff !important; font-size: 20px !important; font-weight: 700 !important; }
:root[data-theme='dark'] .app-shell .editor-empty-desc { color: #a8a8a8 !important; }
:root[data-theme='dark'] .app-shell .workspace-guide,
:root[data-theme='dark'] .app-shell .editor-empty-guide {
  background: #2b2b2b !important;
  border: 1px solid #3d3d3d !important;
  border-radius: 8px !important;
}
:root[data-theme='dark'] .app-shell .learn-steps li {
  background: #333333 !important;
  border: 1px solid #414141 !important;
  border-radius: 6px !important;
  color: #cfcfcf !important;
}
:root[data-theme='dark'] .app-shell .learn-steps li.is-current {
  border-color: #00c1cd !important;
  background: rgba(0, 193, 205, 0.1) !important;
  color: #ffffff !important;
}

/* ════════════ 5 · Rotulado explícito de paneles (comprensión) ═══════════
   Los rótulos se apoyan en cabeceras REALES ya presentes en el DOM
   (`.rail-head`, `.inspector-head h3`, `.preview-hud`, `.timeline-tabs`),
   que `capcut-editor.css` refuerza con mayúsculas y una barra de acento.
   No se inyectan textos decorativos: cada panel conserva su título real. */

:root[data-theme='dark'] .app-shell .editor-grid .preview-panel,
:root[data-theme='dark'] .app-shell .editor-grid .inspector,
:root[data-theme='dark'] .app-shell .editor-grid .timeline-panel { position: relative !important; }

/* ══════════════════ 6 · Mensajes, banners y overlays ══════════════════ */

:root[data-theme='dark'] .app-shell .banner,
:root[data-theme='dark'] .app-shell .recovery-banner {
  background: #2a2a2a !important;
  border-bottom: 1px solid #3d3d3d !important;
  color: #d8d8d8 !important;
  font-size: 11.5px !important;
}
:root[data-theme='dark'] .app-shell .banner-error { border-left: 3px solid var(--color-danger) !important; }
:root[data-theme='dark'] .app-shell .browser-mode-banner {
  background: #213036 !important;
  border-bottom: 1px solid #2c4750 !important;
  color: #cfe9ee !important;
}
:root[data-theme='dark'] .app-shell .settings-window,
:root[data-theme='dark'] .app-shell .cmdp-panel,
:root[data-theme='dark'] .app-shell .start-window {
  background: #262626 !important;
  border: 1px solid #3d3d3d !important;
  border-radius: 10px !important;
  color: #ececec !important;
  box-shadow: 0 24px 70px rgba(0,0,0,0.62) !important;
}

/* ═══════════════ 7 · Densidad y viewport mínimo (1280) ════════════════ */

@media (max-width: 1320px) {
  :root[data-theme='dark'] .app-shell .home-hero { padding: 16px !important; }
  :root[data-theme='dark'] .app-shell .editor-mode-tab { padding: 0 8px !important; font-size: 11px !important; }
  :root[data-theme='dark'] .app-shell .sidebar { width: 42px !important; min-width: 42px !important; }
}
@media (max-width: 1280px) {
  :root[data-theme='dark'] .app-shell .topbar { height: 32px !important; min-height: 32px !important; }
  :root[data-theme='dark'] .app-shell .timeline-toolbar,
  :root[data-theme='dark'] .app-shell .timeline-tabs { height: 32px !important; min-height: 32px !important; }
  :root[data-theme='dark'] .app-shell .rail-tabs button { font-size: 10px !important; }
}

@media (prefers-reduced-motion: reduce) {
  :root[data-theme='dark'] *,
  :root[data-theme='dark'] *::before,
  :root[data-theme='dark'] *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
