{
  "name": "editor-ia-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/desktop",
    "apps/render-worker",
    "packages/project-schema"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @editor-ia/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm test && npm run build",
    "tauri:dev": "npm run tauri:dev --workspace @editor-ia/desktop",
    "tauri:build": "npm run tauri:build --workspace @editor-ia/desktop"
  }
}
