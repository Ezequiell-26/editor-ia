node_modules/
dist/
coverage/
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
target/
apps/desktop/src-tauri/gen/
packages/project-schema/schema/.generated/

# Flow Queue smoke-test artifacts
extensions/flow-queue/tests/smoke-panel.png

# Binarios de terceros empaquetados para el instalador (FFmpeg ~200 MB,
# yt-dlp ~18 MB). No se versionan: GitHub rechaza archivos de más de 100 MB y
# el repo debe quedar liviano. En una máquina de desarrollo se copian a mano o
# se usa el FFmpeg del sistema, que la app detecta al arrancar.
apps/desktop/src-tauri/resources/ffmpeg/
apps/desktop/src-tauri/resources/ffmpeg-dll/
apps/desktop/src-tauri/resources/tools/

# Salidas de Playwright MCP (snapshots de página) y de los e2e
.playwright-mcp/
test-results/
playwright-report/

# ONNX Runtime (binario grande, se instala con un script)
apps/desktop/src-tauri/resources/onnxruntime/

# Artefactos de diagnóstico locales
.tmp-*/
.tmp-*.log
.tmp-*.mjs

# Estado de ejecucion del loop y targets alternativos de compilacion
.editoria-loop/LOOP.lock
target-loop/
.worktrees/
target-build/
.target-architecture/
.cargo-home-architecture/

# Claves privadas de firma: nunca dentro del árbol de build.
*.pem

# Piper: binario y voces pesadas; se instalan con el setup/CI, no en Git
apps/desktop/src-tauri/resources/piper/*
# …excepto los avisos legales GPL-3.0 de eSpeak NG (obligatorios para redistribución)
!apps/desktop/src-tauri/resources/piper/espeak-ng/

# Capturas temporales de diagnóstico
.tmp-*.png

# Estado local de herramientas (no es fuente del proyecto)
.serena/
.workbuddy-ai/

# Artefactos de runtime del proyecto de prueba en la raíz del repo:
# autosaves, exports renderizados y assets del fixture CDP (binarios).
/.olyvia-history/
/exports/
/media/
# `> nul` en Git Bash crea un archivo literal `nul` (nombre reservado de
# Windows) en vez de descartar la salida — no es fuente del proyecto.
/nul
# Proyecto de prueba CDP: estado local de verificación en vivo, no fuente.
/test-cdp.editoria.json
# Scripts one-off de sesiones de agente (codemods `_batch_*`, dispatchers
# `_disp_*`): trabajo ya aplicado, no fuente del proyecto.
/scripts/_*.mjs

# Video de benchmark del harness de LUT (19 MB, se genera aparte)
apps/desktop/e2e/lut-harness/*.mp4

# Artefactos de Vite (config temporal)
*.timestamp-*.mjs

# Estado de otras herramientas (no es fuente del proyecto)
.kiro/

# Backups de hojas de estilo (app.css es la fuente)
apps/desktop/src/styles/*.new
target-polish/

# Logs del loop Devin 24/7
logs/

# Instaladores de release (binarios grandes, se regeneran con tauri build)
deliverables/**/*.exe

# Overlay local de CARGO_HOME (workaround de ACL del cache en D:\DevCache)
.cargo-home/

# local rust build env (system cargo/rustup not writable)
.rustup-local/
.cargo-local/
