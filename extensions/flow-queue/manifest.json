{
  "manifest_version": 3,
  "name": "Flow Queue — Editor IA",
  "short_name": "Flow Queue",
  "version": "0.1.0",
  "description": "Cola de prompts y referencias para Google Flow, con descargas numeradas y manifiesto para Editor IA.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Flow Queue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/lib/adapter.js"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
